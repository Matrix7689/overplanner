{
  "name": "overplanner",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
